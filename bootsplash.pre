# 0 "bootsplash.S"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "bootsplash.S"
# 1 "mmu.h" 1
# 2 "bootsplash.S" 2
# 1 "asm.h" 1
# 3 "bootsplash.S" 2

.code16
.global start
start:
# 16 "bootsplash.S"
# Change to 32-bit protected mode so we can run C code
cli
lgdt gdtdesc
movl %cr0, %eax
orl $0x00000001, %eax
movl %eax, %cr0

ljmp $(1<<3), $start32
.code32 # Tell assembler to generate 32-bit code now.
start32:

movw $(2<<3), %ax # Our data segment selector
movw %ax, %ds # -> DS: Data Segment
movw %ax, %ss # -> SS: Stack Segment

mov $0x1000, %esp
call splashmain

loop:
    jmp loop

hello: .string "xv6 @ UIC rocks!"

# Bootstrap GDT
.p2align 2 # force 4 byte alignment
gdt:
  .word 0, 0; .byte 0, 0, 0, 0 # null seg
  .word (((0xffffffff) >> 12) & 0xffff), ((0x0) & 0xffff); .byte (((0x0) >> 16) & 0xff), (0x90 | (0x8|0x2)), (0xC0 | (((0xffffffff) >> 28) & 0xf)), (((0x0) >> 24) & 0xff) # code seg
  .word (((0xffffffff) >> 12) & 0xffff), ((0x0) & 0xffff); .byte (((0x0) >> 16) & 0xff), (0x90 | (0x2)), (0xC0 | (((0xffffffff) >> 28) & 0xf)), (((0x0) >> 24) & 0xff) # data seg

gdtdesc:
  .word (gdtdesc - gdt - 1) # sizeof(gdt) - 1
  .long gdt # address gdt
